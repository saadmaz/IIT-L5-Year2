# Root .gitignore for IIT-L5-Year2

# Build outputs
**/target/
**/bin/
**/*.class
build/
.dart_tool/
.gradle/
dist/

# Dependencies
node_modules/

# Secrets / local config
.env
.env.*
!.env.example

# Third-party server distributions (download separately)
**/apache-tomcat-*/

# Local editor tooling (VS Code Java upgrade / modernize extension logs)
.github/java-upgrade/
.github/modernize/

# IDE/editor files
.vscode/
.idea/
*.iml

# OS files
Thumbs.db
.DS_Store

# Large media (too big for GitHub; kept locally / on Drive)
Client-Server-Architectures-5COSC022C.2/Coursework/*.mp4
